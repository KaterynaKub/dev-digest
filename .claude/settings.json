{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pr-guard.mjs",
            "if": "Bash(gh pr create*)",
            "timeout": 10,
            "statusMessage": "PR self-review gate…"
          }
        ]
      }
    ]
  }
}
